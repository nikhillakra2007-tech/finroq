# Database
POSTGRES_DB=finroq
POSTGRES_USER=finroq
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS
CORS_ORIGINS=http://localhost:3000

# Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database URL (auto-constructed from above if not set)
# DATABASE_URL=postgresql+asyncpg://finroq:change_me@localhost:5432/finroq

# Finroq AI / OpenAI Provider Configuration (Server-side only)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=20.0
AI_MAX_TOOL_ITERATIONS=5